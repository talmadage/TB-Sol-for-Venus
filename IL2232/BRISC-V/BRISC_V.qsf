# ================================================================
# DE0-Nano Pin Assignments for BRISC_V
# ================================================================

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE22F17C6
set_global_assignment -name TOP_LEVEL_ENTITY BRISC_top_connect
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "12:00:00 DECEMBER 01, 2024"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1"

# ================================================================
# Clock
# ================================================================
set_location_assignment PIN_R8 -to FPGA_CLK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FPGA_CLK_50

# ================================================================
# Keys (Buttons)
# ================================================================
set_location_assignment PIN_J15 -to KEY[0]
set_location_assignment PIN_E1  -to KEY[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[1]

# ================================================================
# LEDs
# ================================================================
set_location_assignment PIN_A15 -to LED[0]
set_location_assignment PIN_A13 -to LED[1]
set_location_assignment PIN_B13 -to LED[2]
set_location_assignment PIN_A11 -to LED[3]
set_location_assignment PIN_D1  -to LED[4]
set_location_assignment PIN_F3  -to LED[5]
set_location_assignment PIN_B1  -to LED[6]
set_location_assignment PIN_L3  -to LED[7]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[7]

# ================================================================
# GPIO_0 Header (10 pins for external communication)
# ================================================================
# Pin 0-7: Bidirectional data
set_location_assignment PIN_D3  -to GPIO_0[0]
set_location_assignment PIN_C3  -to GPIO_0[1]
set_location_assignment PIN_A2  -to GPIO_0[2]
set_location_assignment PIN_A3  -to GPIO_0[3]
set_location_assignment PIN_B3  -to GPIO_0[4]
set_location_assignment PIN_B4  -to GPIO_0[5]
set_location_assignment PIN_A4  -to GPIO_0[6]
set_location_assignment PIN_B5  -to GPIO_0[7]

# Pin 8: TX_VALID
set_location_assignment PIN_A5  -to GPIO_0[8]

# Pin 9: RX_READY
set_location_assignment PIN_D5  -to GPIO_0[9]

# I/O standard for all GPIO
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_0[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_0[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_0[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_0[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_0[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_0[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_0[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_0[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_0[8]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_0[9]

# ================================================================
# Project files
# ================================================================
set_global_assignment -name SDC_FILE BRISC_V.sdc
set_global_assignment -name VHDL_FILE types_pkg.vhd
set_global_assignment -name VHDL_FILE io_controller.vhdl
set_global_assignment -name VHDL_FILE bs_interface.vhd
set_global_assignment -name VHDL_FILE RAM.vhdl
set_global_assignment -name VHDL_FILE RAM_1PORT.vhd
set_global_assignment -name QIP_FILE RAM_1PORT.qip
set_global_assignment -name VHDL_FILE CiscV.vhdl
set_global_assignment -name VHDL_FILE program_package.vhdl
set_global_assignment -name VHDL_FILE BRISC_top.vhdl
set_global_assignment -name VHDL_FILE BRISC_top_connect.vhdl

# ================================================================
# Compilation settings
# ================================================================
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
